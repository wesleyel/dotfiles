global
const uid =() => Math.random().toString(36).slice(2, 8);
endglobal

snippet `(snot|wbk)` "single placeholder func" A
``
const map = {
  snot: "sidenote",
  wbk: "wideblock",
}
rv = `#${map[m[1]]}[`
``${1:${VISUAL}}]
endsnippet

snippet `f(def|ppt|not|thm|trk|cor|ex|sol|pr)` "dual placeholder func" A
``
const env = {
  def: "definition",
  ppt: "property",
  not: "note",
  thm: "theorem",
  trk: "trick",
  cor: "corollary",
  ex: "example",
  sol: "solution",
  pr: "proof",
}
const name = env[m[1]]
const label = ["sol", "pr"].includes(m[1]) ? "" : `(<${m[1]}:${uid()}>)`
rv = `#${name}${label}[\${1}][
`
``${2:${VISUAL}}
]
endsnippet


