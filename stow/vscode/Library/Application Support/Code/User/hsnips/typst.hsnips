# --------- math env ---------
snippet `lim(0|o|i|\+|\-|t)` "limit" iAm
``
const targetMap = {
  "0": "0",
  o: "oo",
  i: "oo",
  "+": "+oo",
  "-": "-oo",
}
if (m[1] === "t") {
  rv = `lim_(\${1:x} → \${2:0}) `
} else {
  rv = `lim_(x → ${targetMap[m[1]]}) `
}
``
endsnippet

snippet `(sum|prod)(1|0|o|a|t)` "sum/product" iAm
``
const op = m[1] === "sum" ? "sum" : "product"
const k = m[2]
if (k === "a") {
  rv = `${op} `
} else if (k === "t") {
  rv = `${op}_(\${1:i} = \${2:1})^\${3:n} \$0`
} else if (k === "1") {
  rv = `${op}_(i = 1)^\${1:n} \$0`
} else if (k === "0") {
  rv = `${op}_(i = 0)^\${1:n} \$0`
} else {
  rv = `${op}_(i = \${1:1})^oo \$0`
}
``
endsnippet

snippet `int(a|1|x|t)` "integral" iAm
``
if (m[1] === "a") {
  rv = `integral_a^\${1:b} \${2:expr} dif x`
} else if (m[1] === "1") {
  rv = `integral_0^1 \${1:expr} dif x`
} else if (m[1] === "x") {
  rv = `integral_\${1:0}^x \${2:expr} dif t`
} else {
  rv = `integral_\${1:a}^\${2:b} \${3:expr} dif \${4:x}`
}
``
endsnippet


priority 100
snippet `cas([es])([1-9]|\s)` "cases environment" iAm
``
const withCondition = m[1] === "s"
const n = /^\s$/.test(m[2]) ? 2 : Number(m[2])
const rows = []
const placeholder = (index, text) => `\${${index}:${text}}`

for (let i = 0; i < n; i++) {
  const expr = placeholder(withCondition ? 2 * i + 1 : i + 1, "expr")
  if (withCondition) {
    const cond = placeholder(2 * i + 2, "cond")
    rows.push(`  ${expr}\\, space & ${cond},`)
  } else {
    rows.push(`  ${expr},`)
  }
}

rv = `cases(\n${rows.join("\n")}\n)`
``
endsnippet


snippet `([A-Za-z\)])(\d)` "auto subscript" iAm
``
rv = `${m[1]}_${m[2]}`
``
endsnippet

snippet `([A-Za-z\)])_(\d{2})` "auto subscript" iAm
``
rv = `${m[1]}_(${m[2]})`
``
endsnippet

snippet `(?<![A-Za-z])([A-Za-hk-z])([acdijkmnpqrstABCDIJKMNPQRST])\2` "auto subscript" iAm
``
rv = `${m[1]}_${m[2]}`
``
endsnippet
